/*
 * SxSSD policy-import ABI manifest.
 *
 * SXS_COMMON_IMPORT(api_name, linker_symbol, native_wrapper,
 *                   wamr_signature, meta_interface_access)
 * SXS_PRIVILEGED_IMPORT(api_name, linker_symbol, native_wrapper,
 *                       wamr_signature)
 *
 * api_name is appended to the namespace's "sxs_" or "sxs_privileged_"
 * prefix.  linker_symbol is the undefined C symbol emitted by the policy
 * compiler.  META marks the common imports available to the built-in
 * meta-interface policy; NO_META excludes them from its narrow allowlist.
 *
 * The typed policy declarations remain in policy-wasm-abi.h and
 * policy-privileged-wasm-abi.h.  The explicit runtime registration tables
 * remain explicit in policy-wamr.c. An ABI change must update both this
 * manifest and those tables.  This manifest also generates the linker
 * allowlists for policy builds.
 */

SXS_COMMON_IMPORT(execution_get, sxs_execution_get,
                  import_execution_get, "(*)i", META)
